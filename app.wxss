page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx;
}

.pet-card {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.pet-image {
  width: 100%;
  height: 400rpx;
}

.pet-info {
  padding: 20rpx;
}

.pet-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.pet-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.pet-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tag {
  background-color: #FFF0F0;
  color: #FF6B6B;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.btn-adopt {
  background-color: #FF6B6B;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  width: 100%;
}

.btn-adopt::after {
  border: none;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #FF6B6B;
}
